exports[`EditModal component answers tab snapshot 1`] = `
<ModalDialog
  className="robbo-grade-modal"
  hasCloseButton={true}
  isFullscreenOnMobile={true}
  isOpen="test-is-open"
  onClose={[MockFunction hooks.onClose]}
  size="xl"
  title="Answers and grade"
>
  <ModalDialog.Header>
    <ModalDialog.Title>
      Answers and grade
    </ModalDialog.Title>
  </ModalDialog.Header>
  <ModalDialog.Body>
    <div>
      <ModalHeaders />
      <Tabs
        activeKey="answers"
        className="robbo-grade-modal__tabs"
        id="robbo-grade-modal-tabs"
        onSelect={[MockFunction hooks.setActiveTab]}
      >
        <Tab
          eventKey="answers"
          title="Answers"
        >
          <LearnerAnswers />
        </Tab>
        <Tab
          eventKey="override"
          title="Change grade"
        >
          <Alert
            dismissible={false}
            show={true}
            variant="danger"
          >
            test-error
          </Alert>
          <OverrideTable />
          <div>
            Showing most recent actions (max 5). To see more, please contact support
          </div>
          <div>
            Note: Once you save, your changes will be visible to students.
          </div>
        </Tab>
      </Tabs>
    </div>
  </ModalDialog.Body>
  <ModalDialog.Footer>
    <ActionRow>
      <ModalDialog.CloseButton
        variant="tertiary"
      >
        Close
      </ModalDialog.CloseButton>
    </ActionRow>
  </ModalDialog.Footer>
</ModalDialog>
`;

