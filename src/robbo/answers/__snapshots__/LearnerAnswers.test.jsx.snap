exports[`LearnerAnswers loaded snapshot 1`] = `
<div
  className="robbo-answers"
>
  <div
    className="robbo-answers__toolbar"
  >
    <p
      className="robbo-answers__summary"
    >
      Problems with mistakes: 1 of 3
      , without an answer: 1
    </p>
    <Form.Switch
      checked={true}
      className="robbo-answers__switch"
      onChange={[MockFunction hooks.handleOnlyErrorsChange]}
    >
      Only mistakes and responses awaiting grading
    </Form.Switch>
  </div>
  <ol
    aria-label="Problems of the assignment"
    className="robbo-answers__list"
  >
    <ProblemAnswers
      courseId="course-v1:Org+Course+Run"
      headingId="robbo-answers-problem-0"
      key="block-v1:Org+Course+Run+type@problem+block@mc"
      problem={
        {
          "answers": [
            {
              "answer": "Motor",
              "correctAnswer": "Motor",
