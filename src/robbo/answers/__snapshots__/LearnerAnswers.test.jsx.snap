exports[`Answer wrong answer with the correct one 1`] = `
<li
  className="robbo-answers__question"
>
  <p
    className="robbo-answers__question-text"
  >
    How many wheels?
  </p>
  <dl
    className="robbo-answers__values"
  >
    <dt>
      Learner's answer
    </dt>
    <AnswerValue
      files={[]}
      mark={
        <Icon
          className="robbo-answers__value-icon--incorrect"
          screenReaderText="Incorrect"
          size="sm"
          src="Cancel"
        />
      }
      text="Two"
    />
    <Fragment>
      <dt>
        Correct answer
      </dt>
      <AnswerValue
        files={[]}
        mark={null}
        text="Four"
      />
    </Fragment>
  </dl>
</li>
`;

exports[`AnswerFiles pictures first, links to the other files 1`] = `
<Fragment>
  <ul
    className="robbo-answers__pictures"
  >
    <AnswerPicture
      file={
        {
          "description": "Front view",
          "image": true,
          "name": "robot.jpg",
          "url": "/openassessment/storage/photo",
        }
      }
      key="/openassessment/storage/photo"
    />
  </ul>
  <ul
    className="robbo-answers__files"
  >
    <li
      className="robbo-answers__file"
      key="/openassessment/storage/program"
    >
      <Icon
        className="robbo-answers__file-icon"
        size="sm"
        src="InsertDriveFile"
      />
      <span
        className="robbo-answers__file-name"
      >
        robot.sb3
      </span>
      <span
        className="robbo-answers__file-description"
      >
        Program
      </span>
      <Hyperlink
        destination="http://localhost:18000/openassessment/storage/program"
        externalLinkAlternativeText="opens in a new tab"
        externalLinkTitle="opens in a new tab"
        target="_blank"
      >
        Download
      </Hyperlink>
    </li>
  </ul>
</Fragment>
`;

exports[`AnswerPicture small picture button 1`] = `
<li
  className="robbo-answers__picture"
>
  <button
    aria-expanded={false}
    aria-label="Enlarge the picture: Front view"
    className="robbo-answers__picture-button"
    onClick={[MockFunction usePicture.toggle]}
    type="button"
  >
    <img
      alt=""
      loading="lazy"
      onError={[MockFunction usePicture.handleError]}
      src="http://localhost:18000/openassessment/storage/photo"
    />
  </button>
  <span
    className="robbo-answers__picture-caption"
  >
    Front view
  </span>
</li>
`;

